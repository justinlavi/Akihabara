{
    "name": "akihabara",
    "displayName": "Akihabara",
    "description": "A neon, concept-driven VS Code color theme inspired by Akihabara at night",
    "version": "5.0.0",
    "private": true,
    "publisher": "justin-lavi",
    "license": "MIT",
    "author": {
        "name": "Justin Lavi",
        "email": "rumtankard@gmail.com"
    },
    "scripts": {
        "build:themes": "node scripts/generate-theme-variants.js",
        "check": "npm run check:node-version && npm run check:public-safety && npm run check:version && npm run check:language-fixtures && npm run check:theme-code-colors && npm run check:generated-themes",
        "check:generated-themes": "node scripts/generate-theme-variants.js --check",
        "check:language-fixtures": "node scripts/check-language-fixtures.js",
        "check:node-version": "node scripts/check-node-version.js",
        "check:public-safety": "node scripts/check-public-safety.js",
        "check:theme-code-colors": "node scripts/check-theme-code-colors.js",
        "check:version": "node scripts/check-version.js",
        "prepublishOnly": "node scripts/block-npm-publish.js",
        "vscode:prepublish": "npm run check",
        "package": "npm run check && vsce package",
        "release:marketplace": "npm run check && vsce publish"
    },
    "engines": {
        "node": ">=22",
        "vscode": "^1.85.0"
    },
    "devDependencies": {
        "@vscode/vsce": "4.0.0"
    },
    "files": [
        "package.json",
        "README.md",
        "LANGUAGE_SUPPORT.md",
        "CHANGELOG.md",
        "assets/icon.png",
        "assets/sample_cpp_header.png",
        "assets/sample_cpp_source.png",
        "themes/**",
        "LICENSE.txt"
    ],
    "icon": "assets/icon.png",
    "homepage": "https://github.com/justinlavi/Akihabara",
    "repository": {
        "type": "git",
        "url": "https://github.com/justinlavi/Akihabara"
    },
    "bugs": {
        "url": "https://github.com/justinlavi/Akihabara/issues",
        "email": "rumtankard@gmail.com"
    },
    "galleryBanner": {
        "color": "#0C0D12",
        "theme": "dark"
    },
    "categories": [
        "Themes"
    ],
    "contributes": {
        "themes": [
            {
                "label": "Akihabara Light",
                "uiTheme": "vs",
                "path": "./themes/akihabara-light-color-theme.json"
            },
            {
                "label": "Akihabara Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/akihabara-dark-color-theme.json"
            },
            {
                "label": "Akihabara OLED",
                "uiTheme": "vs-dark",
                "path": "./themes/akihabara-oled-color-theme.json"
            },
            {
                "label": "Akihabara Experimental",
                "uiTheme": "vs-dark",
                "path": "./themes/akihabara-experimental-color-theme.json"
            }
        ]
    },
    "keywords": [
        "akihabara",
        "city",
        "colorful",
        "clean",
        "cyber",
        "cyberpunk",
        "dark",
        "dark theme",
        "highlighting",
        "japan",
        "light theme",
        "magenta",
        "modern",
        "neon",
        "night",
        "oled theme",
        "pastel",
        "readable",
        "semantics",
        "syntax",
        "theory",
        "tokyo"
    ]
}
