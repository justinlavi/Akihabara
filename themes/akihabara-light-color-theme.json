    "tokenColors": [
        {
            "name": "@Branching (if/else/switch/case)",
            "scope": [
                "keyword.control.case",
                "keyword.control.conditional",
                "keyword.control.default",
                "keyword.control.else",
                "keyword.control.if.cpp",
                "keyword.control.switch",
                "keyword.other.using.directive.cpp"
            ],
            "settings": {
                "foreground": "#7757BA"
            }
        },
        {
            "name": "@Looping (for/while/do)",
            "scope": [
                "keyword.control.do",
                "keyword.control.for",
                "keyword.control.loop",
                "keyword.control.while"
            ],
            "settings": {
                "foreground": "#7757BA"
            }
        },
        {
            "name": "@Transfer (break/continue/return)",
            "scope": [
                "keyword.control.break",
                "keyword.control.continue",
                "keyword.control.flow",
                "keyword.control.return"
            ],
            "settings": {
                "foreground": "#7757BA"
            }
        },
        {
            "name": "@Exceptions (try/catch/throw)",
            "scope": [
                "keyword.control.exception",
                "keyword.control.try",
                "keyword.control.catch",
                "keyword.control.throw"
            ],
            "settings": {
                "foreground": "#7757BA"
            }
        },
        {
            "name": "@Misc Flow (goto / labels)",
            "scope": [
                "entity.name.label",
                "keyword.control.goto"
            ],
            "settings": {
                "foreground": "#7757BA"
            }
        },
        {
            "name": "@Access / Declarations (public/protected/private, class/struct/namespace, ::, etc.)",
            "scope": [
                "entity.other.attribute",
                "punctuation.separator.scope-resolution",
                "storage.type.class",
                "storage.type.enum",
                "storage.type.enum.enum-key.class.cpp",
                "storage.type.interface",
                "storage.type.modifier.access",
                "storage.type.namespace",
                "storage.type.struct",
                "storage.type.template",
                "storage.type.union",
                "support.other.attribute",
                "support.type.targetProperty.cmake",
                "variable.other.unknown.public"
            ],
            "settings": {
                "foreground": "#7757BA"
            }
        },
        {
            "name": "@Booleans (true/false)",
